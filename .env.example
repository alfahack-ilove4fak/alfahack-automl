# Скопируйте этот файл в .env и впишите значения:  cp .env.example .env   (Windows: copy .env.example .env)
# .env НИКОГДА не коммитится (он в .gitignore). Ключи не пишем в чат, код, issue и PR.

# --- LLM: те же переменные, что в baseline.py организаторов ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Кэш ответов LLM: повторные запуски на той же задаче не тратят общий бюджет 600 ₽/день
LLM_CACHE_DIR=llm_cache
# Сколько рублей один локальный запуск агента может потратить на LLM (0 — без ограничения)
LLM_RUB_LIMIT=20
# Остаток по ключу: curl -sS https://changellenge.up.railway.app/key/info -H "Authorization: Bearer $OPENAI_API_KEY"
# Лимит 600 ₽/день действует только на разработку; на платформе ограничений на токены нет.
# Цены за 1000 токенов в рублях — ⚠️ организаторы не назвали, пока 0 (рубли не считаются)
LLM_PRICE_RUB_PER_1K_INPUT=0
LLM_PRICE_RUB_PER_1K_OUTPUT=0
# Длина рассуждений Qwen: low — коротко и дёшево (по умолчанию), пусто — как решит модель (в 2.5 раза дороже)
LLM_REASONING_EFFORT=low
# Потоковый ответ: 1 — да (прокси рвёт обычный запрос через ~10 с), 0 — нет
LLM_STREAM=1
# Пауза LLM после 3 сбоев подряд, с (сервер под нагрузкой рвёт соединения)
LLM_COOLDOWN_SEC=120
# 1 — работать без LLM вообще (только playbook); удобно для быстрых прогонов
LLM_MOCK=0

# --- Локальные прогоны агента ---
# На платформе 3 часа (10800). Для быстрой проверки ставьте 300–600.
AGENT_TIME_BUDGET_SEC=600
# Куда писать логи запуска
AGENT_RUN_DIR=runs/latest
